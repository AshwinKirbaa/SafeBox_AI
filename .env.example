# SafeBox AI - Member 1 module. Copy to backend/.env for local overrides.
# Contains NO secrets. Never commit a real .env file.
SAFEBOX_APP_NAME=SafeBox AI
SAFEBOX_ENVIRONMENT=development

# "mock" (default, no Ollama needed) or "ollama"
SAFEBOX_TARGET_MODE=mock

# Ollama (only used when requests target ollama and SAFEBOX_TARGET_MODE=ollama)
SAFEBOX_OLLAMA_BASE_URL=http://127.0.0.1:11434
SAFEBOX_OLLAMA_MODEL=llama3.2:1b
SAFEBOX_ALLOW_REMOTE_OLLAMA=false

SAFEBOX_INFERENCE_TIMEOUT_SECONDS=30
SAFEBOX_MAX_PROMPT_LENGTH=4000
SAFEBOX_MAX_RESPONSE_CHARS=4000
SAFEBOX_MAX_REQUEST_BYTES=16384
SAFEBOX_MAX_CONCURRENT_RUNS=2
SAFEBOX_MAX_RUN_SECONDS=120

SAFEBOX_DATABASE_PATH=data/safebox.sqlite3
SAFEBOX_EVIDENCE_MAX_EXCERPT_CHARS=500
# 0 = keep forever
SAFEBOX_EVIDENCE_RETENTION_DAYS=30

# Loopback by default. Binding elsewhere requires an explicit opt-in.
SAFEBOX_HOST=127.0.0.1
SAFEBOX_PORT=8000
SAFEBOX_ALLOW_NON_LOOPBACK=false

# Shared token the Member 2 worker sends as X-Worker-Token. Leave empty in
# development (worker submissions are then accepted only in development env).
SAFEBOX_WORKER_TOKEN=
